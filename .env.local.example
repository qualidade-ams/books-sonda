# ⚡ OTIMIZAÇÃO: Caminho do navegador para geração de PDF em desenvolvimento
# Defina o caminho do Chrome ou Edge instalado no seu sistema
# Isso acelera MUITO o vercel dev (não precisa carregar @sparticuz/chromium)

# Windows - Chrome
# BROWSER_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"

# Windows - Edge (recomendado para Windows 11)
BROWSER_PATH="C:\Program Files\Microsoft\Edge\Application\msedge.exe"

# macOS - Chrome
# BROWSER_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# macOS - Edge
# BROWSER_PATH="/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"

# Linux - Chrome
# BROWSER_PATH="/usr/bin/google-chrome"

# Linux - Chromium
# BROWSER_PATH="/usr/bin/chromium-browser"

# Supabase (copie do .env.production)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
