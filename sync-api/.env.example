# SQL Server Configuration
SQL_SERVER=seu-servidor-sql
SQL_PORT=10443
SQL_DATABASE=Aranda
SQL_USER=seu-usuario-sql
SQL_PASSWORD=sua-senha-sql
SQL_TABLE=AMSpesquisa

# Supabase Configuration
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua-service-key

# API Configuration
PORT=3001
NODE_ENV=development

# Agendador de sincronização (tela "Sincronização SQL Server")
# true só no servidor de produção — em dev local deixe false para não disparar jobs
SCHEDULER_ENABLED=false
