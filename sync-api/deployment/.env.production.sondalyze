# ============================================
# Configuração de Produção - Sync API (sondalyze.com.br)
# ============================================
#
# Este arquivo é o MODELO de produção para o ambiente sondalyze.
# No servidor, copie para o .env efetivo:
#
#   copy deployment\.env.production.sondalyze .env
#
# ⚠️ NÃO comitar o .env efetivo com credenciais reais (já coberto pelo .gitignore).
# ⚠️ Este arquivo é a Opção A: sync-api rodando no MESMO servidor do SQL Server.

# ============================================
# SQL Server Configuration
# ============================================
# Como a API roda no mesmo servidor do SQL Server, use localhost.
# ⚠️ CONFIRMAR A PORTA no servidor:
#    - Instância padrão normalmente escuta em 1433
#    - Este projeto tem histórico de uso da porta 10443 (ver .env.temp / .env.example)
#    Ajuste SQL_PORT conforme o que o SQL Server realmente escuta localmente.
SQL_SERVER=localhost
SQL_PORT=10443
SQL_DATABASE=Aranda
SQL_USER=amsconsulta
# ⚠️ Preencher a senha real diretamente no .env do servidor (não versionar)
SQL_PASSWORD=COLOQUE_A_SENHA_SQL_AQUI_NO_SERVIDOR
SQL_TABLE=AMSpesquisa
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# Timeouts (em milissegundos)
SQL_CONNECTION_TIMEOUT=30000
SQL_REQUEST_TIMEOUT=30000

# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=https://qiahexepsdggkzgmklhq.supabase.co
# ⚠️ Preencher com a SERVICE KEY real diretamente no .env do servidor (não versionar)
SUPABASE_SERVICE_KEY=COLOQUE_A_SERVICE_KEY_AQUI_NO_SERVIDOR

# ============================================
# API Configuration
# ============================================
# A API escuta apenas em localhost:3001 (o Nginx faz o HTTPS na frente).
PORT=3001
NODE_ENV=production

# Domínio público servido pelo Nginx (referência/documentação):
# https://sync-api.sondalyze.com.br

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/sync-api.log

# ============================================
# Performance
# ============================================
# Número máximo de conexões simultâneas ao SQL Server
MAX_POOL_SIZE=10

# Intervalo de sincronização automática (em minutos)
# Deixe vazio/comentado para desabilitar sincronização automática
# AUTO_SYNC_INTERVAL=15
